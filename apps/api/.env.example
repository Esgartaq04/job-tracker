# Copy to .env for local development. Every value has a working default;
# see docs/GETTING_STARTED.md for the full table.

# Postgres in any deployed environment; SQLite is the zero-setup local default.
# DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@localhost:5432/job_tracker

# Unset means: ingestion runs in-process and SSE uses an in-memory hub.
# REDIS_URL=redis://localhost:6379/0

# Change before deploying — this signs every session token.
JWT_SECRET=dev-secret-change-me

# Enables Tier 4 (LLM structuring). Without it the pipeline stops at Tier 3.
# ANTHROPIC_API_KEY=

# Tier 3 (Playwright). Install the `browser` extra first: pip install -e ".[browser]"
# INGEST_BROWSER_ENABLED=0
